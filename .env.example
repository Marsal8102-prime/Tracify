# ================================================
# Tracify — Environment Variable Overrides
# ================================================
# Copy this file to .env and fill in your values.
# These override the defaults in ml-engine/config/settings.yaml
# ================================================

# ---- Camera ----
# Source type: "usb", "rtsp", or "file"
TRACIFY_CAMERA_TYPE=usb
# USB device index, RTSP URL, or video file path
TRACIFY_CAMERA_SOURCE=0

# ---- Detection ----
# Minimum confidence to accept a detected face (0.0 - 1.0)
TRACIFY_DETECTION_CONFIDENCE=0.5
# Maximum number of faces to detect per frame (0 = unlimited)
TRACIFY_DETECTION_MAX_FACES=0

# ---- Recognition ----
# Minimum cosine similarity to classify a face as "known" (0.0 - 1.0)
TRACIFY_RECOGNITION_THRESHOLD=0.6

# ---- Embedding ----
# ONNX Runtime execution provider for embedding model: "cpu" or "gpu"
TRACIFY_EMBEDDING_PROVIDER=cpu

# ---- Logging ----
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
TRACIFY_LOG_LEVEL=INFO
# Log format: "json" (production) or "text" (development)
TRACIFY_LOG_FORMAT=text

# ---- Paths (usually no need to change) ----
# TRACIFY_MODELS_DIR=ml-engine/models
# TRACIFY_STORAGE_DIR=ml-engine/storage
# TRACIFY_LOGS_DIR=ml-engine/logs

# ---- Backend to ML Engine ----
ML_ENGINE_URL=http://127.0.0.1:8001
ML_ENGINE_CONNECT_TIMEOUT_SECONDS=2.0
ML_ENGINE_READ_TIMEOUT_SECONDS=30.0
ML_ENGINE_WRITE_TIMEOUT_SECONDS=30.0
ML_ENGINE_POOL_TIMEOUT_SECONDS=2.0
ML_ENGINE_HEALTH_TIMEOUT_SECONDS=3.0
